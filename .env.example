# ==========================================
# KEEPR ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# ------------------------------------------
# Application & Server
# ------------------------------------------
NODE_ENV=development
PORT=5001
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------
# Database (PostgreSQL 15+ / 17)
# ------------------------------------------
# Local development format:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/keepr?schema=public"

# Test database format (used during automated tests):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/keepr_test?schema=public"

# ------------------------------------------
# In-Memory Cache & Job Queue (Redis)
# ------------------------------------------
# Local Redis:
REDIS_URL="redis://127.0.0.1:6379"

# Cloud Redis (e.g. Upstash Free Tier with TLS):
# REDIS_URL="rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379"

# ------------------------------------------
# Cryptography & Security
# ------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET="replace_with_a_secure_random_32_character_string_for_production"
JWT_EXPIRES_IN="7d"

# Storage HMAC signing key for secure private document downloads
STORAGE_SIGNING_SECRET="replace_with_another_secure_random_32_character_string"

# ------------------------------------------
# Document Storage Driver
# ------------------------------------------
# Options: 'local' (filesystem) or 's3' (AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="uploads"

# Optional S3-compatible configuration (Cloudflare R2 free 10GB tier or AWS S3):
# STORAGE_S3_BUCKET="keepr-documents"
# STORAGE_S3_REGION="auto"
# STORAGE_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# STORAGE_S3_ACCESS_KEY_ID="your_access_key"
# STORAGE_S3_SECRET_ACCESS_KEY="your_secret_key"

# ------------------------------------------
# Email Service Provider
# ------------------------------------------
# Options: 'mock' (in-memory dev inspection via /api/notifications/dev-outbox) or 'smtp' (Resend, Brevo, SendGrid, Gmail)
EMAIL_PROVIDER="mock"
EMAIL_FROM="Keepr <noreply@keepr.app>"

# Optional SMTP Settings (e.g. Resend / Brevo free tier):
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="resend"
# SMTP_PASS="re_your_api_key_here"

# ------------------------------------------
# Frontend Environment Variables (Vite)
# ------------------------------------------
# Placed in frontend/.env for production builds if frontend is hosted on separate domain:
# VITE_API_BASE_URL="https://your-api.onrender.com"
